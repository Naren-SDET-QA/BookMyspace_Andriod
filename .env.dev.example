# BookMySpace DEV Environment Template
# Copy to .env.dev for local development. Never commit real keys!

APP_ENV=development
SUPABASE_URL=https://dev-project-ref.supabase.co
SUPABASE_ANON_KEY=dev_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=dev_service_role_key_here
SUPABASE_DB_PASSWORD=dev_db_password_here

RAZORPAY_KEY_ID=rzp_test_dev_key_id
RAZORPAY_KEY_SECRET=rzp_test_dev_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_dev_webhook

GOOGLE_MAPS_ANDROID_API_KEY=dev_google_maps_key
GOOGLE_MAPS_IOS_API_KEY=dev_google_maps_key

# ------------------------------------------------------------
# End-to-end test accounts (DEV only). These users must exist in
# the DEV Supabase Auth (see supabase/seed_dev.sql and
# supabase/migrations/20260912180000_grant_dev_test_roles.sql).
# Passwords live only in your local .env.dev — never commit them.
# Customer pair is required for booking-side E2E; the owner pair
# unblocks the owner approval flow (BMS E2E gate, owner step).
# ------------------------------------------------------------
DEV_E2E_CUSTOMER_EMAIL=customer.dev@bookmyspace.app
DEV_E2E_CUSTOMER_PASSWORD=change_me_customer
DEV_E2E_OWNER_EMAIL=owner.dev@bookmyspace.app
DEV_E2E_OWNER_PASSWORD=change_me_owner
